# =============================================================================
# CityPulse - Smart City Emergency Response & Live Traffic Management
# Environment Configuration
# =============================================================================

# Server Port (default: 8000)
PORT=8000

# Secret Key for Admin Authentication Session Tokens
SECRET_KEY=citypulse-nagpur-smart-city-emergency-secret-key-2026

# Database File Path (defaults to backend/citypulse.db if left unset)
CITYPULSE_DB_PATH=backend/citypulse.db

# -----------------------------------------------------------------------------
# LIVE TRAFFIC FLOW CONFIGURATION (OPTIONAL)
# -----------------------------------------------------------------------------
# CityPulse adheres strictly to data integrity:
# - OpenStreetMap interactive street map: 100% FREE & LIVE (no API key needed)
# - OSRM road routing: 100% FREE & LIVE (no API key needed)
# - Hospital discovery (OSM Overpass): 100% FREE & LIVE (no API key needed)
#
# If you wish to display legitimate real-time traffic congestion flow tiles:
# 1. Register a free developer account at https://developer.tomtom.com/
# 2. Generate a Traffic API key (free tier includes 2,500 daily requests)
# 3. Paste the key below and restart CityPulse.
#
# If left empty, the traffic layer toggle will clearly state "Traffic API key not
# configured in .env", and the interactive OpenStreetMap street map will remain
# completely functional.
TOMTOM_API_KEY=
